            {"type": "heading", "attrs": {"level": 3}, "content": [{"type": "text", "text": "Étapes pour reproduire"}]},
            {"type": "orderedList", "content": [
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Appliquer le code promo BIENVENUE10 sur un panier de 2 articles."}]}]},
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supprimer les 2 articles du panier."}]}]},
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ajouter un nouvel article."}]}]}
            ]},
            {"type": "paragraph", "content": [{"type": "text", "text": "Résultat obtenu : la réduction de 10 % s'applique au nouvel article alors que le code n'a pas été ressaisi."}]},
            {"type": "heading", "attrs": {"level": 3}, "content": [{"type": "text", "text": "Résultat attendu"}]},
            {"type": "paragraph", "content": [{"type": "text", "text": "Le code promo est retiré quand le panier est vidé ; le client doit le saisir à nouveau."}]}
