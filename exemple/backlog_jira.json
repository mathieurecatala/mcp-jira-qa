            {"type": "heading", "attrs": {"level": 3}, "content": [{"type": "text", "text": "Critères d'acceptation"}]},
            {"type": "bulletList", "content": [
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "La page de la commande affiche le statut parmi : préparée, expédiée, en livraison, livrée."}]}]},
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Le numéro de suivi du transporteur est cliquable et ouvre le site du transporteur."}]}]},
              {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Un e-mail part au client à chaque changement de statut, au plus 15 minutes après le changement."}]}]}
            ]}
          ]
        }
      }
    },
